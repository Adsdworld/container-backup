#!/bin/bash
# Copies every folder of /source into /backup/data, once.
#
# /backup/data/
# ├── files/          git repository: the files of the sources, without their .git folders
# ├── repositories/   one bare mirror per git repository found in the sources
# ├── staging/        the raw copy of the sources, kept to make the next copy faster
# └── ALERTS          what was found changed in a history already recorded
#
# The sources are hostile: nothing found in them is ever run or trusted. Their
# files are copied as bytes, their attributes and ignore files are not honoured,
# and git only reads their repositories after their configuration is replaced.
set -uo pipefail

SOURCES="${BACKUP_SOURCES:-/source}"
DATA="${BACKUP_DATA:-/backup/data}"
STAGING="$DATA/staging"
FILES="$DATA/files"
MIRRORS="$DATA/repositories"
ALERTS="$DATA/ALERTS"
# The empty tree: attributes are read from it instead of the copied files.
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

now="$(date -Is)"
# The same instant, in a form a git ref name accepts.
stamp="$(date -u -d "$now" +%Y%m%dT%H%M%SZ)"
summary=()

log() {
    echo "$(date -Is) $*"
}

alert() {
    echo "$now $*" >> "$ALERTS"
    log "ALERT $*"
    summary+=("ALERT $*")
}

# git with no system, global or attribute configuration from anywhere else.
safe_git() {
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git \
        -c core.hooksPath=/dev/null -c core.fsmonitor=false \
        -c core.autocrlf=false -c core.excludesFile=/dev/null \
        -c "attr.tree=$EMPTY_TREE" "$@"
}

init_repository() {
    [ -d "$1" ] && return
    safe_git init -q "$@"
    safe_git -C "$1" config user.name backup
    safe_git -C "$1" config user.email backup@localhost
    safe_git -C "$1" config gc.auto 0
    safe_git -C "$1" config gc.pruneExpire never
    safe_git -C "$1" config gc.reflogExpire never
    safe_git -C "$1" config gc.reflogExpireUnreachable never
    safe_git -C "$1" config core.logAllRefUpdates always
}

# Replaces what git would read and run in a copied repository.
sanitize() {
    local dir="$1"
    printf '[core]\n\trepositoryformatversion = 0\n\tbare = true\n' > "$dir/config"
    rm -rf "$dir/hooks" "$dir/objects/info/alternates" "$dir/objects/info/http-alternates" \
        "$dir/commondir" "$dir/info/grafts" "$dir/shallow"
}

# Records the refs of one copied repository in its mirror, never losing one.
mirror() {
    local source="$1" name="$2"
    local target="$MIRRORS/$name.git"
    sanitize "$source"
    init_repository "$target" --bare
    touch "$target/seen"
    rm -f "$target/gone"

    safe_git -C "$target" for-each-ref --format='delete %(refname)' refs/incoming/ \
        | safe_git -C "$target" update-ref --stdin
    if ! safe_git -C "$target" fetch -q --no-tags --no-write-fetch-head \
        "$source" '+refs/*:refs/incoming/*' 2> /dev/null; then
        # An empty repository has no ref to fetch; anything else is worth saying.
        if [ -n "$(safe_git --git-dir="$source" for-each-ref --count=1 2> /dev/null)" ]; then
            alert "$name: its history could not be read"
            return
        fi
    fi

    local ref kept new old incoming=()
    while IFS= read -r ref; do
        ref="${ref#refs/incoming/}"
        incoming+=("$ref")
        kept="refs/source/$ref"
        new="$(safe_git -C "$target" rev-parse "refs/incoming/$ref")"
        old="$(safe_git -C "$target" rev-parse -q --verify "$kept" || true)"
        if [ -z "$old" ]; then
            safe_git -C "$target" update-ref "$kept" "$new"
        elif [ "$old" != "$new" ]; then
            if ! safe_git -C "$target" merge-base --is-ancestor "$old" "$new"; then
                safe_git -C "$target" update-ref "refs/rewritten/$stamp/$ref" "$old"
                alert "$name: $ref was rewritten, the previous history is kept as refs/rewritten/$stamp/$ref"
            fi
            safe_git -C "$target" update-ref "$kept" "$new"
        fi
    done < <(safe_git -C "$target" for-each-ref --format='%(refname)' refs/incoming/)

    while IFS= read -r ref; do
        ref="${ref#refs/source/}"
        if ! printf '%s\n' ${incoming[@]+"${incoming[@]}"} | grep -qxF -- "$ref"; then
            safe_git -C "$target" update-ref "refs/deleted/$stamp/$ref" "refs/source/$ref"
            safe_git -C "$target" update-ref -d "refs/source/$ref"
            alert "$name: $ref was deleted, it is kept as refs/deleted/$stamp/$ref"
        fi
    done < <(safe_git -C "$target" for-each-ref --format='%(refname)' refs/source/)

    safe_git -C "$target" for-each-ref --format='delete %(refname)' refs/incoming/ \
        | safe_git -C "$target" update-ref --stdin
}

mkdir -p "$STAGING" "$MIRRORS"
touch "$ALERTS"
init_repository "$FILES"

excludes=()
for pattern in ${BACKUP_EXCLUDE:-}; do
    excludes+=(--exclude "$pattern")
done

sources=0
for source in "$SOURCES"/*/; do
    [ -d "$source" ] || continue
    name="$(basename "$source")"
    sources=$((sources + 1))
    # Symbolic links are copied as links, never followed; no device or special file.
    if ! rsync -rlpt --delete --delete-excluded --no-specials --no-devices \
        ${excludes[@]+"${excludes[@]}"} "$source" "$STAGING/$name/"; then
        alert "$name: the copy is incomplete"
    fi
done
if [ "$sources" -eq 0 ]; then
    log "nothing to copy: no folder in $SOURCES"
    exit 1
fi
# Sources that are no longer mounted leave the staging area.
for staged in "$STAGING"/*/; do
    [ -d "$staged" ] || continue
    [ -d "$SOURCES/$(basename "$staged")" ] || rm -rf "$staged"
done

# Git repositories found in the sources: their .git folders.
find "$MIRRORS" -name seen -path '*.git/seen' -delete
while IFS= read -r -d '' dir; do
    relative="${dir#"$STAGING/"}"
    mirror "$dir" "${relative%/.git}"
done < <(find "$STAGING" -type d -name .git -prune -print0)
while IFS= read -r -d '' target; do
    [ -e "$target/seen" ] || [ -e "$target/gone" ] && continue
    name="${target#"$MIRRORS/"}"
    touch "$target/gone"
    alert "${name%.git}: the repository was deleted, its mirror is kept"
done < <(find "$MIRRORS" -type d -name '*.git' -prune -print0)

# The files themselves, without the .git folders.
rsync -rlpt --delete --exclude .git "$STAGING/" "$FILES/"
safe_git -C "$FILES" add --all --force .
if safe_git -C "$FILES" diff --cached --quiet; then
    log "copy done, nothing changed"
else
    changes="$(safe_git -C "$FILES" diff --cached --shortstat)"
    message="Copy of $now"$'\n\n'"${changes# }"
    if [ ${#summary[@]} -gt 0 ]; then
        message+=$'\n\n'"$(printf '%s\n' "${summary[@]}")"
    fi
    safe_git -C "$FILES" commit -q -m "$message"
    log "copy done:${changes}"
fi
